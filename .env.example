# Supabase mirror sync configuration. Points at reindb (shared
# Supabase project hosting contrl + buffr under separate schemas).
# Copy to .env and fill in. Never commit .env.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: defaults to 00000000-0000-0000-0000-000000000001.
# Set when you add real auth or want explicit tenant ID.
# EXPO_PUBLIC_USER_ID=
